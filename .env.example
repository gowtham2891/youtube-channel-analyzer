# ---------------------------------------------------------------------------
# Provider selection
# Leave both on "mock" to analyze a synthetic channel with no credentials.
# ---------------------------------------------------------------------------
DATA_SOURCE=mock          # mock | youtube
ANALYZER=mock             # mock | gemini

# --- YouTube Data API v3 ---------------------------------------------------
# Create a key at https://console.cloud.google.com and enable "YouTube Data API v3"
YOUTUBE_API_KEY=
YOUTUBE_BASE_URL=https://www.googleapis.com/youtube/v3

# --- Gemini ----------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
TEMPERATURE=0.4
MAX_TOKENS=2000

# --- Analysis behaviour ----------------------------------------------------
MAX_VIDEOS=50
MAX_TRANSCRIPTS=10
TRANSCRIPT_CHARS=3000
FETCH_TRANSCRIPTS=true
TRANSCRIPT_LANGUAGES=en,te,hi

# --- Networking ------------------------------------------------------------
REQUEST_TIMEOUT=30
MAX_RETRIES=3
OUTPUT_DIR=output
